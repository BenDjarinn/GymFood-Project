{
  "expo": {
    "name": "GymFood",
    "scheme": "gymfood",
    "slug": "GymFood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/gymfood-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "splash": {
        "backgroundColor": "#0A1628"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/gymfood-logo.png",
        "backgroundColor": "#0A1628"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.GymFood"
    },
    "web": {
      "favicon": "./src/assets/gymfood-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo"
    ]
  }
}
